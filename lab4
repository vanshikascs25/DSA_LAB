#include<stdio.h>
#include<stdlib.h>
struct node{
    int data;
    struct node* link;
};
struct node* insertion(struct node *head,int n){
    struct node *pre=NULL;
    pre=head;
    while(n!=0){
        struct node *temp=(struct node*)malloc(sizeof(struct node));
        printf("enter the data :");
        int data;
        if(head==NULL){
            scanf("%d",&temp->data);
            head=temp;
        }
        else{
            scanf("%d",&temp->data);
            pre->link=temp;
        }
        pre=temp;
        temp->link=NULL;
        n--;
    }
    return head;
}
void del_front(struct node **head){
    struct node *temp=*head;
    *head=temp->link;
    free(temp);
}
void del_end(struct node *head){
    struct node *temp=head;
    while(temp->link->link!=NULL){
        temp=temp->link;
    }
    free(temp->link);
    temp->link=NULL;
}
void del_mid(struct node **head,int pos){
    if(*head==NULL)return;
    if(pos==1){
        del_front(head);
        return;
    }
    struct node *temp=*head;
    while(pos!=2){
        temp=temp->link;
        pos--;
    }
    struct node *del=temp->link;
    temp->link=del->link;
    free(del);
}
void print(struct node *head){
    struct node *temp=head;
    while(temp!=NULL){
        printf("%d %p\n",temp->data,temp->link);
        temp=temp->link;
    }
}
