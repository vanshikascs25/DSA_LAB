    head=insert_node(head,10);
    head=insert_node(head,11);
    pr_value(head);
    printf("\n\n");

    //del front
    head=del_front(head);
    pr_value(head);
    printf("\n\n");

    //del end
    head=del_end(head);
    pr_value(head);
