//Ques 1:Write a program to reverse a doubly linked list.

#include<stdio.h>
#include<stdlib.h>
struct node{
    int data;
    struct node* next;
};
struct node* insert_node(struct node* head,int data){
    struct node* new_n=(struct node*)malloc(sizeof(struct node));
    if(head==NULL){
        new_n->data=data;
        new_n->next=new_n;
        head=new_n;
    }
    else{
        struct node* temp=head;
        while(temp->next!=head){
            temp=temp->next;
        }
        new_n->data=data;
        new_n->next=head;
        temp->next=new_n;
    }
    return head;
}

struct node* rev_lst(struct node* head) {
    struct node* prev = NULL;
    struct node* ptr = head;
    struct node* next = NULL;
    do {
        next = ptr->next;
        ptr->next = prev;
        prev = ptr;
        ptr= next;
    }while(ptr!=head);
    head = prev;
    struct node* temp=head;
    while(temp->next!=NULL){
        temp=temp->next;
    }
    temp->next=head;
    return head;
}

void print_value(struct node *head){
    struct node* temp=head;
    do{
        printf("%d ->",temp->data);
        temp=temp->next;
    }while(temp!=head);
    printf("....");
}
int main(){
    struct node* head=NULL;
    head=insert_node(head,40);
    head=insert_node(head,50);
    head=insert_node(head,60);
    head=insert_node(head,70);
    print_value(head);

    printf("\n\n\n");
    head=rev_lst(head);
    print_value(head);
}

//Ques 2: Write a program for delete in a circular linked list

#include<stdio.h>
#include<stdlib.h>
struct node{
    int data;
    struct node *link;
};
struct node* insert_node(struct node* head,int data){
    struct node* newnode=(struct node*)malloc(sizeof(struct node));
    if(head==NULL){
        head=newnode;
        newnode->data=data;
        newnode->link=head;
    }
    else{
        struct node* ptr=head;
        while(ptr->link!=head){
            ptr=ptr->link;
        }
        newnode->data=data;
        ptr->link=newnode;
        newnode->link=head;
    }
    return head;
}

struct node* del_front(struct node* head){
    struct node* ptr=head;
    while(ptr->link !=head){
        ptr=ptr->link;
    }
    ptr->link=head->link;
    free(head);
    head=ptr->link;
    return head;
}

struct node* del_end(struct node* head){
    struct node* ptr=head;
    while(ptr->link->link !=head){
        ptr=ptr->link;
    }
    free(ptr->link);
    ptr->link=head;
    return head;
}
struct node* del_index(struct node*head,int pos){
    struct node* ptr=head;
    for(int i=1;i<(pos-1);i++){
        ptr=ptr->link;
    }
    if(pos==1) return del_front(head);
    struct node* temp=ptr->link;
    ptr->link=temp->link;
    free(temp);
    return head;
}
void pr_value(struct node *head){
    struct node* ptr=head;
    do{
        printf("%d-> ",ptr->data);
        ptr=ptr->link;
    }while(ptr!=head);
    printf("head");
}
