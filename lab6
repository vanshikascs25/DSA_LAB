};
struct stack* push(struct stack* head){
    printf("enter the number of element : ");
    int n;
    scanf("%d",&n);
    struct stack* pre=(struct stack*)malloc(sizeof(struct stack));
    for(int i=0;i<n;i++){
        struct stack* newnode=(struct stack*)malloc(sizeof(struct stack));
        if(newnode==NULL){
            printf("OVERFLOW");
            break;
        }

        printf("enter the number of element : ");
        int data;
        scanf("%d",&data);
        if(head==NULL){
            newnode->data=data;
            head=newnode;
            newnode->link=NULL;
        }
        else{
            newnode->data=data;
            newnode->link=NULL;
            pre->link=newnode;
        }
        pre=newnode;
    }
    return head;
}

struct stack* pop(struct stack* head) {
    if (head == NULL){
        printf("UNDERFLOW");
        return head;
    }
    if ((head)->link == NULL) {
        free(head);
        head = NULL;
        return head;
    }
    struct stack* temp = head;
    while (temp->link->link!= NULL) {
        temp = temp->link;
    }
    free(temp->link);
    temp->link = NULL;
    return head;
}

void top(struct stack **head){
    struct stack* prev = NULL;
    struct stack* ptr = *head;
    struct stack* next = NULL;

    while (ptr != NULL) {
        next = ptr->link;
        ptr->link = prev;
        prev = ptr;
        ptr= next;
    }
    *head = prev;
    struct stack* temp=*head;
    while(temp!=NULL){
        printf("%d ",temp->data);
        temp=temp->link;
    }
}

